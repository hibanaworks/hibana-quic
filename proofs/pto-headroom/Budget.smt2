(set-logic QF_LIA)
(declare-const ordinary Int)
(declare-const probes Int)
(declare-const rounds Int)
(push)
(assert (and (<= 0 ordinary) (<= ordinary 48) (< (- 64 ordinary) 16)))
(check-sat)
(pop)
(push)
(assert (and (<= 0 ordinary) (<= ordinary 48) (<= 0 probes) (< probes 16) (>= (+ ordinary probes) 64)))
(check-sat)
(pop)
(push)
(assert (and (<= 0 ordinary) (<= ordinary 48) (<= 0 rounds) (<= rounds 8) (> (+ ordinary (* 2 rounds)) 64)))
(check-sat)
(pop)
(push)
(assert (and (= ordinary 64) (<= (+ ordinary 1) 64)))
(check-sat)
(pop)
; Negative witness for the old policy: ordinary traffic could occupy all records.
(push)
(assert (and (= ordinary 64) (= probes 0) (= (- 64 ordinary probes) 0)))
(check-sat)
(pop)
