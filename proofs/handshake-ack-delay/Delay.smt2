(set-logic QF_LIA)
(declare-const latest Int)
(declare-const minimum Int)
(declare-const delay Int)
(declare-const maximum Int)
(assert (and (>= minimum 0) (>= latest minimum) (>= delay 0) (>= maximum 0)))
(define-fun adjusted () Int (ite (>= latest (+ minimum delay)) (- latest delay) latest))
(push)
(assert (< adjusted minimum))
(check-sat)
(pop)
(push)
(assert (and (= latest (+ minimum delay)) (not (= adjusted minimum))))
(check-sat)
(pop)
(push)
(assert (and (< latest (+ minimum delay)) (not (= adjusted latest))))
(check-sat)
(pop)
(push)
(assert (> (ite (< delay maximum) delay maximum) maximum))
(check-sat)
(pop)
; A nonzero buffering delay makes the old unadjusted estimate larger.
(push)
(assert (and (= latest (+ minimum delay)) (> delay 0) (> latest adjusted)))
(check-sat)
(pop)
