(set-logic QF_LIA)
(declare-const base Int)
(declare-const ms Int)
(declare-const pto Int)
(declare-const now Int)
(assert (and (>= base 0) (>= ms 0) (>= pto 0)))
(define-fun duration () Int (ite (>= (* 1000 ms) (* 3 pto)) (* 1000 ms) (* 3 pto)))
(define-fun deadline () Int (+ base duration))
(push)
(assert (< deadline (+ base (* 3 pto))))
(check-sat)
(pop)
(push)
(assert (< deadline (+ base (* 1000 ms))))
(check-sat)
(pop)
(push)
(assert (and (< now deadline) (>= now deadline)))
(check-sat)
(pop)
(push)
(assert (<= deadline 18446744073709551615))
(assert (< deadline base))
(check-sat)
(pop)
; A deadline really can expire; the model must not forbid every terminal.
(push)
(assert (= now deadline))
(check-sat)
(pop)
